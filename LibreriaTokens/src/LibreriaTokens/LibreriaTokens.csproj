<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>LibreriaTokens</AssemblyName>
    <RootNamespace>LibreriaTokens</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ACSA</Authors>
    <Product>LibreriaTokens</Product>
    <Description>Normalizacion de whitespace y estimacion de tokens para bajar el consumo de entrada al llamar LLMs (OpenAI, Anthropic). Cero dependencias externas.</Description>
    <!-- CS1591: no exigir comentario XML en cada miembro publico. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
