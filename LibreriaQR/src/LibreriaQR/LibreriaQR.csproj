<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>LibreriaQR</AssemblyName>
    <RootNamespace>LibreriaQR</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>WanakAI</Authors>
    <Product>LibreriaQR</Product>
    <Description>Generacion de codigos QR para .NET 10 con 13 tipos de contenido (URL, texto, telefono, SMS, WiFi, vCard, MeCard, correo, ubicacion GPS, evento, 2FA/OTP, mensajeria y criptomonedas), logo centrado y salida PNG/base64/data-uri. Espanol.</Description>
    <!-- CS1591: no exigir comentario XML en cada miembro publico. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- QRCoder: algoritmo QR (Reed-Solomon, enmascarado) + generadores de payload. Sin binarios nativos.
         SkiaSharp (MIT): render del mapa de bits y composicion del logo, sin System.Drawing. Reemplaza a
         SixLabors.ImageSharp 2.1.x, que tenia vulnerabilidades sin corregir en la linea Apache-2.0 (la
         correccion solo existe en 3.x/4.x, de pago para empresas con facturacion alta). SkiaSharp trae los
         binarios nativos de Windows y macOS; NativeAssets.Linux.NoDependencies cubre Linux y contenedores. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

</Project>
