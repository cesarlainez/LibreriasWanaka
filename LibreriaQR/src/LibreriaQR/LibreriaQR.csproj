<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>LibreriaQR</AssemblyName>
    <RootNamespace>LibreriaQR</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ACSA</Authors>
    <Product>LibreriaQR</Product>
    <Description>Generacion de codigos QR para .NET 10 con 13 tipos de contenido (URL, texto, telefono, SMS, WiFi, vCard, MeCard, correo, ubicacion GPS, evento, 2FA/OTP, mensajeria y criptomonedas), logo centrado y salida PNG/base64/data-uri. Espanol.</Description>
    <!-- CS1591: no exigir comentario XML en cada miembro publico. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- QRCoder: algoritmo QR (Reed-Solomon, enmascarado) + generadores de payload. Sin binarios nativos.
         SixLabors.ImageSharp: render del mapa de bits y composicion del logo. 100% gestionado (sin
         System.Drawing ni libs nativas), multiplataforma. Se ancla en la ultima 2.1.x porque esa linea
         conserva la licencia Apache-2.0 (la 3.x cambio a la Six Labors Split License, de pago para
         empresas con facturacion alta). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

</Project>
