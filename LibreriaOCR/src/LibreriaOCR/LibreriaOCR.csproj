<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>LibreriaOCR</AssemblyName>
    <RootNamespace>LibreriaOCR</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ACSA</Authors>
    <Description>Librería de OCR para .NET 10 (PDF, PNG, JPG, TIFF) basada en Tesseract. Español.</Description>
    <!-- CS1591: no exigir comentario XML en cada miembro público.
         CA1416: el rasterizado de PDF (PDFtoImage) corre en escritorio/servidor (Windows/Linux/macOS). -->
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>

  <!-- Copia los archivos de idioma (.traineddata) al bin, y de ahí a quien referencie la DLL.
       Se declara como <Content> (no <None>) porque MSBuild solo propaga contenido con
       CopyToOutputDirectory a proyectos consumidores cuando el item es Content: con <None> el
       archivo quedaba en el bin de LibreriaOCR pero NUNCA llegaba al bin de la Api/Worker que
       hacen ProjectReference, y Tesseract fallaba al arrancar buscando spa.traineddata. -->
  <ItemGroup>
    <Content Include="tessdata\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\tessdata</PackagePath>
    </Content>
  </ItemGroup>

</Project>
